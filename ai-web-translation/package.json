{
  "name": "ai-web-translation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "浏览器 AI 翻译插件：可配置翻译服务的划词翻译与整页双语翻译",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:dev-fake": "cross-env AIWT_FAKE_ENGINE=1 wxt build",
    "prepare:wxt": "wxt prepare",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run compile && npm run test && npm run build && npm run build:dev-fake",
    "e2e": "npm run build:dev-fake && playwright test",
    "e2e:prod": "npm run build && playwright test -c playwright.prod.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "cross-env": "^10.0.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wxt": "^0.21.5"
  }
}
